# Copiar a .env en la instancia EC2 (bash deploy/instalar.sh lo hace automáticamente).
# Reemplaza IP_ELASTICA antes de desplegar.
# instalar.sh genera DJANGO_SECRET_KEY y DB_PASSWORD aleatorios y los escribe aquí;
# no versiones credenciales reales en este archivo.
DJANGO_SECRET_KEY=reemplaza-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=IP_ELASTICA,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://IP_ELASTICA

# Ponlo en True solo cuando Nginx sirva HTTPS; con HTTP la sesión no funcionaría.
DJANGO_SECURE_COOKIES=False

DB_ENGINE=postgresql
DB_NAME=dulcearte
DB_USER=dulcearte
# instalar.sh lo reemplaza por una clave aleatoria (o usa la variable DB_PASS).
DB_PASSWORD=reemplaza-por-una-clave-fuerte
DB_HOST=127.0.0.1
DB_PORT=5432
