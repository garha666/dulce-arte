# Copiar a .env en la instancia EC2 (bash deploy/instalar.sh lo hace automáticamente).
# Reemplaza SECRET_KEY y IP_ELASTICA antes de desplegar.
DJANGO_SECRET_KEY=reemplaza-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=IP_ELASTICA,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://IP_ELASTICA

DB_ENGINE=postgresql
DB_NAME=dulcearte
DB_USER=dulcearte
