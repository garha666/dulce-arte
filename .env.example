# ---------------------------------------------------------------- Django
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# En EC2 con HTTPS: DJANGO_SECURE_COOKIES=True (con HTTP debe quedar False).
DJANGO_SECURE_COOKIES=False

# ------------------------------------------------------------ Base de datos
# postgresql (EC2 / Docker) | sqlite (solo pruebas sin servidor)
DB_ENGINE=postgresql
DB_NAME=dulcearte
DB_USER=dulcearte
DB_PASSWORD=dulcearte2026
DB_HOST=127.0.0.1
# 5433 = puerto publicado por docker-compose.yml en local (el 5432 del equipo suele estar ocupado).
# En la instancia EC2 con PostgreSQL nativo se usa 5432.
DB_PORT=5433
